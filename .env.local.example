NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for scripts/import-questions.mjs and server routes — never expose to the client, never commit the real value
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key — usado SOMENTE pra indexação de provas em PDF no /simulado
# (leitura nativa de PDF, veja indexarProvaComGemini em src/lib/gemini.ts)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Provedor único de IA pra explicação/resolução de questões (server-only).
# Formato compatível com OpenAI chat.completions (Groq, OpenAI, OpenRouter,
# proxy local etc). Sem fallback — configure aqui o endpoint e a key reais.
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
