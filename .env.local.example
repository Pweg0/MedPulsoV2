NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for scripts/import-questions.mjs and server routes — never expose to the client, never commit the real value
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key for on-demand question explanations (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude API key — fallback for indexing simulado exams when Gemini fails/times out (server-only)
ANTHROPIC_API_KEY=
ANTHROPIC_INDEXADOR_MODEL=claude-sonnet-5
